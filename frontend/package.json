    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@lezer/highlight": "^1.2.5",
    "@mantine/core": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/modals": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "chordsheetjs": "^18.0.0",
    "codemirror": "^6.0.2",
